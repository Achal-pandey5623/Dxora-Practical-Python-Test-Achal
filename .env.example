# Mastodon: create an app/user token with write:statuses scope.
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky: use an app password, not your account password.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social

# Reddit: OAuth app credentials and an account with permission to post to the subreddit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=
REDDIT_TITLE=An update
REDDIT_USER_AGENT=automated-multi-platform-posting/1.0 by u/YOUR_REDDIT_USERNAME

# LinkedIn: access token with w_member_social OR w_organization_social, plus author URN.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_MEMBER_ID
LINKEDIN_API_VERSION=202610

# X: OAuth 2.0 user-context access token with tweet.write and users.read scopes.
X_USER_ACCESS_TOKEN=

REQUEST_TIMEOUT_SECONDS=20

# Safe by default: simulate results locally without contacting any platform.
DRY_RUN=true
